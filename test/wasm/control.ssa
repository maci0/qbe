export
function w $max(w %a, w %b) {
@start
	%c =w csgtw %a, %b
	jnz %c, @left, @right
@left
	ret %a
@right
	ret %b
}

export
function w $abs(w %x) {
@start
	%neg =w csltw %x, 0
	jnz %neg, @negate, @done
@negate
	%r =w sub 0, %x
	ret %r
@done
	ret %x
}

export
function w $sum(w %n) {
@start
	jmp @head
@head
	%i =w phi @start 1, @body %i1
	%s =w phi @start 0, @body %s1
	%c =w csgtw %i, %n
	jnz %c, @end, @body
@body
	%s1 =w add %s, %i
	%i1 =w add %i, 1
	jmp @head
@end
	ret %s
}

export
function w $clamp(w %x, w %lo, w %hi) {
@start
	%below =w csltw %x, %lo
	jnz %below, @retlo, @check
@check
	%above =w csgtw %x, %hi
	jnz %above, @rethi, @retx
@retlo
	ret %lo
@rethi
	ret %hi
@retx
	ret %x
}

export
function w $fib(w %n) {
@start
	jmp @head
@head
	%i =w phi @start 0, @body %i1
	%a =w phi @start 0, @body %b
	%b =w phi @start 1, @body %ab
	%c =w csgew %i, %n
	jnz %c, @end, @body
@body
	%ab =w add %a, %b
	%i1 =w add %i, 1
	jmp @head
@end
	ret %a
}
