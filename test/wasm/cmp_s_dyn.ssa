# expected: 1 w
# all 6 f32 comparisons with dynamic operands

function w $cmps(s %a, s %b, s %c) {
@start
	%eq =w ceqs %a, %c
	%ne =w cnes %a, %b
	%lt =w clts %a, %b
	%gt =w cgts %b, %a
	%le =w cles %a, %c
	%ge =w cges %c, %a
	%t0 =w and %eq, %ne
	%t1 =w and %t0, %lt
	%t2 =w and %t1, %gt
	%t3 =w and %t2, %le
	%r =w and %t3, %ge
	ret %r
}

export
function w $test() {
@start
	%r =w call $cmps(s s_1.0, s s_2.0, s s_1.0)
	ret %r
}
