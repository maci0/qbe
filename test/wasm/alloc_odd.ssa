# expected: 1 w
# alloc with non-aligned sizes to test alignment masking

export
function w $test() {
@start
	%p4 =l alloc4 1
	storew 10, %p4
	%a =w load %p4
	%achk =w ceqw %a, 10
	%p8 =l alloc8 3
	storel 20, %p8
	%b =l load %p8
	%bchk =w ceql %b, 20
	%p16 =l alloc16 1
	storel 30, %p16
	%c =l load %p16
	%cchk =w ceql %c, 30
	%t0 =w and %achk, %bchk
	%r =w and %t0, %cchk
	ret %r
}
