;; store_load_sb (signed byte round-trip)
(assert_return (invoke "store_load_sb" (i32.const 0)) (i32.const 0))
(assert_return (invoke "store_load_sb" (i32.const 127)) (i32.const 127))
(assert_return (invoke "store_load_sb" (i32.const 128)) (i32.const -128))
(assert_return (invoke "store_load_sb" (i32.const 255)) (i32.const -1))
(assert_return (invoke "store_load_sb" (i32.const -1)) (i32.const -1))

;; store_load_ub (unsigned byte round-trip)
(assert_return (invoke "store_load_ub" (i32.const 0)) (i32.const 0))
(assert_return (invoke "store_load_ub" (i32.const 127)) (i32.const 127))
(assert_return (invoke "store_load_ub" (i32.const 128)) (i32.const 128))
(assert_return (invoke "store_load_ub" (i32.const 255)) (i32.const 255))
(assert_return (invoke "store_load_ub" (i32.const -1)) (i32.const 255))

;; store_load_sh (signed halfword round-trip)
(assert_return (invoke "store_load_sh" (i32.const 0)) (i32.const 0))
(assert_return (invoke "store_load_sh" (i32.const 32767)) (i32.const 32767))
(assert_return (invoke "store_load_sh" (i32.const 32768)) (i32.const -32768))
(assert_return (invoke "store_load_sh" (i32.const 65535)) (i32.const -1))
(assert_return (invoke "store_load_sh" (i32.const -1)) (i32.const -1))

;; store_load_uh (unsigned halfword round-trip)
(assert_return (invoke "store_load_uh" (i32.const 0)) (i32.const 0))
(assert_return (invoke "store_load_uh" (i32.const 32767)) (i32.const 32767))
(assert_return (invoke "store_load_uh" (i32.const 32768)) (i32.const 32768))
(assert_return (invoke "store_load_uh" (i32.const 65535)) (i32.const 65535))
(assert_return (invoke "store_load_uh" (i32.const -1)) (i32.const 65535))

;; store_load_w (i32 round-trip)
(assert_return (invoke "store_load_w" (i32.const 0)) (i32.const 0))
(assert_return (invoke "store_load_w" (i32.const 1)) (i32.const 1))
(assert_return (invoke "store_load_w" (i32.const -1)) (i32.const -1))
(assert_return (invoke "store_load_w" (i32.const 0xdeadbeef)) (i32.const 0xdeadbeef))
(assert_return (invoke "store_load_w" (i32.const 0x7fffffff)) (i32.const 0x7fffffff))

;; store_load_l (i64 round-trip)
(assert_return (invoke "store_load_l" (i64.const 0)) (i64.const 0))
(assert_return (invoke "store_load_l" (i64.const 1)) (i64.const 1))
(assert_return (invoke "store_load_l" (i64.const -1)) (i64.const -1))
(assert_return (invoke "store_load_l" (i64.const 0x100000000)) (i64.const 0x100000000))
(assert_return (invoke "store_load_l" (i64.const 0x7fffffffffffffff)) (i64.const 0x7fffffffffffffff))

;; store_load_s (f32 round-trip)
(assert_return (invoke "store_load_s" (f32.const 0.0)) (f32.const 0.0))
(assert_return (invoke "store_load_s" (f32.const 1.0)) (f32.const 1.0))
(assert_return (invoke "store_load_s" (f32.const -1.0)) (f32.const -1.0))
(assert_return (invoke "store_load_s" (f32.const 3.14)) (f32.const 3.14))

;; store_load_d (f64 round-trip)
(assert_return (invoke "store_load_d" (f64.const 0.0)) (f64.const 0.0))
(assert_return (invoke "store_load_d" (f64.const 1.0)) (f64.const 1.0))
(assert_return (invoke "store_load_d" (f64.const -1.0)) (f64.const -1.0))
(assert_return (invoke "store_load_d" (f64.const 3.141592653589793)) (f64.const 3.141592653589793))
