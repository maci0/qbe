;; neg i32
(assert_return (invoke "neg_w" (i32.const 0)) (i32.const 0))
(assert_return (invoke "neg_w" (i32.const 1)) (i32.const -1))
(assert_return (invoke "neg_w" (i32.const -1)) (i32.const 1))
(assert_return (invoke "neg_w" (i32.const 0x7fffffff)) (i32.const 0x80000001))
(assert_return (invoke "neg_w" (i32.const 0x80000000)) (i32.const 0x80000000))
(assert_return (invoke "neg_w" (i32.const 42)) (i32.const -42))

;; neg i64
(assert_return (invoke "neg_l" (i64.const 0)) (i64.const 0))
(assert_return (invoke "neg_l" (i64.const 1)) (i64.const -1))
(assert_return (invoke "neg_l" (i64.const -1)) (i64.const 1))
(assert_return (invoke "neg_l" (i64.const 0x7fffffffffffffff)) (i64.const 0x8000000000000001))
(assert_return (invoke "neg_l" (i64.const 0x8000000000000000)) (i64.const 0x8000000000000000))
(assert_return (invoke "neg_l" (i64.const 42)) (i64.const -42))

;; neg f32
(assert_return (invoke "neg_s" (f32.const 0.0)) (f32.const -0.0))
(assert_return (invoke "neg_s" (f32.const -0.0)) (f32.const 0.0))
(assert_return (invoke "neg_s" (f32.const 1.0)) (f32.const -1.0))
(assert_return (invoke "neg_s" (f32.const -1.0)) (f32.const 1.0))
(assert_return (invoke "neg_s" (f32.const inf)) (f32.const -inf))
(assert_return (invoke "neg_s" (f32.const -inf)) (f32.const inf))

;; neg f64
(assert_return (invoke "neg_d" (f64.const 0.0)) (f64.const -0.0))
(assert_return (invoke "neg_d" (f64.const -0.0)) (f64.const 0.0))
(assert_return (invoke "neg_d" (f64.const 1.0)) (f64.const -1.0))
(assert_return (invoke "neg_d" (f64.const -1.0)) (f64.const 1.0))
(assert_return (invoke "neg_d" (f64.const inf)) (f64.const -inf))
(assert_return (invoke "neg_d" (f64.const -inf)) (f64.const inf))
