# expected: 126 w
# test that stack pointer is restored after alloc
# Three half-page allocations require the stack to be restored.

export
function w $alloc_and_return(w %v) {
@start
	%p =l alloc4 32768
	storew %v, %p
	%r =w load %p
	ret %r
}

export
function w $test() {
@start
	%a =w call $alloc_and_return(w 42)
	%b =w call $alloc_and_return(w 42)
	%c =w call $alloc_and_return(w 42)
	%s =w add %a, %b
	%r =w add %s, %c
	ret %r
}
