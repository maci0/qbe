;; extsb (sign-extend byte)
(assert_return (invoke "extsb" (i32.const 0)) (i32.const 0))
(assert_return (invoke "extsb" (i32.const 0x7f)) (i32.const 127))
(assert_return (invoke "extsb" (i32.const 0x80)) (i32.const -128))
(assert_return (invoke "extsb" (i32.const 0xff)) (i32.const -1))
(assert_return (invoke "extsb" (i32.const 0x12345600)) (i32.const 0))
(assert_return (invoke "extsb" (i32.const 0xfedcba80)) (i32.const -128))
(assert_return (invoke "extsb" (i32.const -1)) (i32.const -1))

;; extsh (sign-extend halfword)
(assert_return (invoke "extsh" (i32.const 0)) (i32.const 0))
(assert_return (invoke "extsh" (i32.const 0x7fff)) (i32.const 32767))
(assert_return (invoke "extsh" (i32.const 0x8000)) (i32.const -32768))
(assert_return (invoke "extsh" (i32.const 0xffff)) (i32.const -1))
(assert_return (invoke "extsh" (i32.const 0x01230000)) (i32.const 0))
(assert_return (invoke "extsh" (i32.const 0xfedc8000)) (i32.const -32768))
(assert_return (invoke "extsh" (i32.const -1)) (i32.const -1))

;; extub (zero-extend byte)
(assert_return (invoke "extub" (i32.const 0)) (i32.const 0))
(assert_return (invoke "extub" (i32.const 0x7f)) (i32.const 127))
(assert_return (invoke "extub" (i32.const 0x80)) (i32.const 128))
(assert_return (invoke "extub" (i32.const 0xff)) (i32.const 255))
(assert_return (invoke "extub" (i32.const 0xffffff80)) (i32.const 128))
(assert_return (invoke "extub" (i32.const -1)) (i32.const 255))

;; extuh (zero-extend halfword)
(assert_return (invoke "extuh" (i32.const 0)) (i32.const 0))
(assert_return (invoke "extuh" (i32.const 0x7fff)) (i32.const 32767))
(assert_return (invoke "extuh" (i32.const 0x8000)) (i32.const 32768))
(assert_return (invoke "extuh" (i32.const 0xffff)) (i32.const 65535))
(assert_return (invoke "extuh" (i32.const 0xffff8000)) (i32.const 32768))
(assert_return (invoke "extuh" (i32.const -1)) (i32.const 65535))

;; extsw (sign-extend i32 to i64)
(assert_return (invoke "extsw" (i32.const 0)) (i64.const 0))
(assert_return (invoke "extsw" (i32.const 1)) (i64.const 1))
(assert_return (invoke "extsw" (i32.const -1)) (i64.const -1))
(assert_return (invoke "extsw" (i32.const 0x7fffffff)) (i64.const 2147483647))
(assert_return (invoke "extsw" (i32.const 0x80000000)) (i64.const -2147483648))

;; extuw (zero-extend i32 to i64)
(assert_return (invoke "extuw" (i32.const 0)) (i64.const 0))
(assert_return (invoke "extuw" (i32.const 1)) (i64.const 1))
(assert_return (invoke "extuw" (i32.const -1)) (i64.const 4294967295))
(assert_return (invoke "extuw" (i32.const 0x7fffffff)) (i64.const 2147483647))
(assert_return (invoke "extuw" (i32.const 0x80000000)) (i64.const 2147483648))
